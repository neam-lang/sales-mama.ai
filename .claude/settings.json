{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__apollo__apollo_emailer_campaigns_add_contact_ids",
      "mcp__apollo__apollo_emailer_*",
      "mcp__apollo__apollo_sequences_*"
    ],
    "ask": [
      "Bash(python3 scripts/send.py --send *)",
      "Bash(python3 scripts/connect.py whatsapp *)",
      "mcp__companydata__company_enrich",
      "mcp__companydata__field_lookup",
      "mcp__rocketreach__company_lookup",
      "mcp__rocketreach__profile_company_lookup",
      "mcp__rocketreach__person_search",
      "mcp__rocketreach__email_verify",
      "mcp__apollo__apollo_organizations_enrich",
      "mcp__apollo__apollo_people_match",
      "mcp__apollo__apollo_mixed_people_api_search",
      "mcp__apollo__apollo_contacts_create",
      "Bash(python3 scripts/connect.py companydata *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/session_start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/sync.py\" --quiet"
          }
        ]
      }
    ]
  }
}
